<!--
  GideonRaid / Bindings.xml

  API ref 12.1.0: https://warcraft.wiki.gg/wiki/Creating_key_bindings
  Constraints verified on that page:
    - the client loads Bindings.xml AUTOMATICALLY: the file must NOT be listed
      in GideonRaid.toc ;
    - the body of a <Binding> is Lua executed INSECURELY: it therefore cannot
      call a #protected function (C_Ping.SendMacroPing is #protected), and here
      it is only used to open the intermission panel ;
    - `header` resolves the global BINDING_HEADER_GIDEONRAID and the displayed
      label comes from BINDING_NAME_GIDEONRAID_INTERMISSION (defined in
      GideonRaid.lua) ;
    - no default key: the player assigns their own in
      Options > Keybindings > GideonRaid (no existing shortcut is overwritten).

  To be confirmed in game: the binding shows up in the keybindings list
  (an XML file cannot be tested outside the client).
-->
<Bindings>
    <Binding name="GIDEONRAID_INTERMISSION" header="GIDEONRAID">
        if GideonRaid and GideonRaid.UI and GideonRaid.UI.IntermissionToggle then GideonRaid.UI.IntermissionToggle() end
    </Binding>
</Bindings>
