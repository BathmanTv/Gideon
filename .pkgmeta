# .pkgmeta — BigWigsMods/packager (release.sh) or BigWigsMods/packager@v2 action
#
# Directives checked against:
# https://github.com/BigWigsMods/packager (README, section "The PackageMeta file")

package-as: GideonRaid

# The packaged folder = GideonRaid/ (it contains GideonRaid.toc). The repository
# also holds tests/, tools/, docs/ : everything must be excluded from the zip.
ignore:
  - .busted
  - .github
  - .gitignore
  - .luacheckrc
  - .pkgmeta
  - assets
  - docs
  - tests
  - tools
  - Makefile
  - README.md
  - stylua.toml
  - .release

# No external library for now. Uncomment when a library is embedded.
# externals:
#   LibStub:
#     url: https://repos.wowace.com/wow/libstub/trunk
#   CallbackHandler-1.0:
#     url: https://repos.wowace.com/wow/callbackhandler/trunk/CallbackHandler-1.0

# We only produce the version WITH libs (the guild installs from the zip).
enable-nolib-creation: no

# A single save: no need to generate per-client-flavour TOC files.
enable-toc-creation: no

# Metadata used by CurseForge / Wago for the dependencies.
required-dependencies: []
optional-dependencies: []

# Use OUR curated English changelog instead of dumping raw commit messages
# (older commits were written in French and leaked into the release notes).
manual-changelog: CHANGELOG.md

tools-used: []
