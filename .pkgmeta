# .pkgmeta — BigWigsMods/packager (release.sh) or BigWigsMods/packager@v2 action
#
# Directives checked against:
# https://github.com/BigWigsMods/packager (README, section "The PackageMeta file")

package-as: GideonRaid

# The packaged folder = GideonRaid/ (it contains GideonRaid.toc). The repository
# also holds tests/, tools/, docs/ : everything must be excluded from the zip.
# NOTE: Sound/ is NOT listed here ON PURPOSE - the sound files (the three
# assignment soundboards AND intermission-start.ogg, the intermission start sound)
# are ADDON assets and MUST be packaged: they are listed in GideonRaid.toc, the
# client refuses to load an unlisted sound, and a test
# (tests/spec/sound_spec.lua) fails if this ignore list ever covers Sound/.
#
# NOTE: Texture/ is NOT listed here either, and for the SAME reason: it holds the
# three TGA of the image buttons of the intermission panel (the raid lead's
# screenshots of the orbs). The client refuses to load an unlisted texture, the
# files are listed in GideonRaid.toc, and tests/spec/texture_spec.lua fails if
# this ignore list ever covers Texture/. The PNG sources and the documentation
# images stay in assets/, which IS ignored here on purpose.
ignore:
  - .busted
  - .github
  - .gitignore
  - .luacheckrc
  - .pkgmeta
  - assets
  - docs
  - tests
  - tools
  - Makefile
  - README.md
  - stylua.toml
  - .release

# No external library for now. Uncomment when a library is embedded.
# externals:
#   LibStub:
#     url: https://repos.wowace.com/wow/libstub/trunk
#   CallbackHandler-1.0:
#     url: https://repos.wowace.com/wow/callbackhandler/trunk/CallbackHandler-1.0

# We only produce the version WITH libs (the guild installs from the zip).
enable-nolib-creation: no

# A single save: no need to generate per-client-flavour TOC files.
enable-toc-creation: no

# Metadata used by CurseForge / Wago for the dependencies.
required-dependencies: []
optional-dependencies: []

# Use OUR curated English changelog instead of dumping raw commit messages
# (older commits were written in French and leaked into the release notes).
manual-changelog: CHANGELOG.md

tools-used: []
